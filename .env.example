# Copie para .env. O .env não é commitado.

# Compose (Postgres local em localhost:5433)
POSTGRES_USER=firenze
POSTGRES_PASSWORD=firenze
POSTGRES_DB=firenze

# API — prefixo FIRENZE_ (ver apps/api/src/firenze/config.py)
FIRENZE_ENVIRONMENT=dev
FIRENZE_DATABASE_URL=postgresql+psycopg://firenze:firenze@localhost:5433/firenze
FIRENZE_REDIS_URL=redis://localhost:6379/0

# Modelo: aihub, fake ou none (ADR-0007, ADR-0008).
#   fake  -> sem rede, sem chave, texto sintético marcado com [fake]
#   aihub -> AI Hub da Magalu (o produto se chamava Prosa até setembro/2026);
#            base_url e chave saem do console
# Padrão none porque uma chave ausente tem que falhar dizendo o que falta.
FIRENZE_MODEL_PROVIDER=none
FIRENZE_MODEL_BASE_URL=https://api.inferencia.llm.mglu.io/v1

# A dupla medida contra o endpoint real (ver docs/08-achados.md):
#   FIRENZE_MODEL_NAME=nvidia-llama-3.3-70b-instruct-fp8
#   FIRENZE_CLASSIFIER_MODEL_NAME=google-gemma-4-12b-it
#
# ATENÇÃO aos modelos de raciocínio do catálogo — toda a família qwen3 vem com
# thinking ligado e devolve `content: None` com o pensamento em
# `reasoning_content`. Eles não servem para nenhuma das duas portas enquanto não
# houver como desligar isso.
FIRENZE_MODEL_NAME=
# Modelo do classificador de entrada. Vazio = o mesmo acima.
# Roda a cada turno sobre uma frase; o mais barato que der conta basta (RN-040).
FIRENZE_CLASSIFIER_MODEL_NAME=

# Nunca commitar valor real. O .env não é versionado.
# Se a chave já vive em outra variável sua, dá para apontar para ela:
#   FIRENZE_MODEL_API_KEY=${AI_HUB_API_KEY}
FIRENZE_MODEL_API_KEY=
