{
  "components": {
    "schemas": {
      "AccusationText": {
        "description": "What a player typed, before it is a form.",
        "properties": {
          "text": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "AccusationText",
        "type": "object"
      },
      "Answer": {
        "description": "What came back, and what it cost.\n\n`answered` is false when a reply was produced and then discarded — by the\noutput filters, or by the provider declining. The turn is spent, because the\nplayer had their go.\n\nAn unreachable model is not this shape: it is a 503 and costs nothing.\n\n`reason` stays coarse on purpose. The detail can quote the canary token the\nreply was discarded for, which is precisely the thing that must not travel.",
        "properties": {
          "alibi_broken": {
            "default": false,
            "description": "The evidence caught them out. A game event, not a fault (RN-021).",
            "title": "Alibi Broken",
            "type": "boolean"
          },
          "answered": {
            "title": "Answered",
            "type": "boolean"
          },
          "character": {
            "title": "Character",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "`rejected` or `model_unavailable`, when unanswered.",
            "title": "Reason"
          },
          "stance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Stance"
              },
              {
                "type": "null"
              }
            ]
          },
          "turns_left": {
            "title": "Turns Left",
            "type": "integer"
          }
        },
        "required": [
          "answered",
          "character",
          "turns_left"
        ],
        "title": "Answer",
        "type": "object"
      },
      "CastMember": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "stance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Stance"
              },
              {
                "type": "null"
              }
            ],
            "description": "How they are holding up. Absent until they have been asked."
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "title": "CastMember",
        "type": "object"
      },
      "Confrontation": {
        "properties": {
          "evidence": {
            "description": "Fact id the player holds, e.g. F-014.",
            "title": "Evidence",
            "type": "string"
          },
          "suspect": {
            "description": "Character id, e.g. sus-1.",
            "title": "Suspect",
            "type": "string"
          }
        },
        "required": [
          "suspect",
          "evidence"
        ],
        "title": "Confrontation",
        "type": "object"
      },
      "DraftAccusation": {
        "description": "The form, filled in from prose, for the player to confirm.\n\nNothing here has been committed. `POST /accusation` takes these fields back,\nwhich is what makes the confirmation structural rather than a convention:\nthere is no way to accuse in prose.",
        "properties": {
          "culprit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Culprit"
          },
          "culprit_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Culprit Name"
          },
          "evidence": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Evidence",
            "type": "array"
          },
          "evidence_text": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Evidence Text",
            "type": "array"
          },
          "motive": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Motive"
          },
          "motive_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Motive Key"
          },
          "summary": {
            "description": "The sentence to show before it counts.",
            "title": "Summary",
            "type": "string"
          },
          "unresolved": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Unresolved",
            "type": "array"
          }
        },
        "required": [
          "summary"
        ],
        "title": "DraftAccusation",
        "type": "object"
      },
      "FloorPlan": {
        "description": "The empty board the player fills in, and nothing else.\n\nRooms and hours — never who was where. A server that handed over a filled\nplan would be solving the game: reconstructing the night from what people\nclaimed *is* the deduction, so the claims stay in the answers a player has\nto read, and reach the plan only in the review of a finished match (RN-035).\n\nNeither list is a secret. The rooms are the house and the hours are the\nnight; the briefing already says where the body was found — and since it\ndoes, saying it again in fields the front end can read is the same\ninformation, not more of it. Prose a player has to parse by eye is not a\nsecurity boundary.",
        "properties": {
          "crime_interval": {
            "description": "When it was found. Already in the briefing.",
            "title": "Crime Interval",
            "type": "integer"
          },
          "crime_room": {
            "description": "Where the body was found. Already in the briefing.",
            "title": "Crime Room",
            "type": "string"
          },
          "hours": {
            "items": {
              "$ref": "#/components/schemas/Hour"
            },
            "title": "Hours",
            "type": "array"
          },
          "rooms": {
            "items": {
              "$ref": "#/components/schemas/Room"
            },
            "title": "Rooms",
            "type": "array"
          }
        },
        "required": [
          "rooms",
          "hours",
          "crime_room",
          "crime_interval"
        ],
        "title": "FloorPlan",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "description": "Liveness probe response.",
        "properties": {
          "environment": {
            "enum": [
              "dev",
              "staging",
              "prod"
            ],
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "environment"
        ],
        "title": "Health",
        "type": "object"
      },
      "HeldEvidence": {
        "description": "A fact the player was holding by the end, and how it got there.",
        "properties": {
          "given_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Given By"
          },
          "given_by_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Given By Name"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "turn": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Absent when it was public from the briefing.",
            "title": "Turn"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "title": "HeldEvidence",
        "type": "object"
      },
      "Hour": {
        "properties": {
          "interval": {
            "description": "Index into the night, 0-based.",
            "title": "Interval",
            "type": "integer"
          },
          "label": {
            "description": "Clock time, e.g. `22h30`.",
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "interval",
          "label"
        ],
        "title": "Hour",
        "type": "object"
      },
      "KnownFact": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "title": "KnownFact",
        "type": "object"
      },
      "MatchState": {
        "description": "Everything a player may see. No solution, no bookkeeping.",
        "properties": {
          "cast": {
            "items": {
              "$ref": "#/components/schemas/CastMember"
            },
            "title": "Cast",
            "type": "array"
          },
          "evidence": {
            "default": [],
            "description": "Fact ids the player holds and may present.",
            "items": {
              "type": "string"
            },
            "title": "Evidence",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "known": {
            "items": {
              "$ref": "#/components/schemas/KnownFact"
            },
            "title": "Known",
            "type": "array"
          },
          "known_motives": {
            "default": [],
            "description": "Motives the player found out about, and may therefore name.",
            "items": {
              "type": "string"
            },
            "title": "Known Motives",
            "type": "array"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "notebook": {
            "items": {
              "$ref": "#/components/schemas/Said"
            },
            "title": "Notebook",
            "type": "array"
          },
          "plan": {
            "$ref": "#/components/schemas/FloorPlan",
            "description": "The house and the night, empty. Constant for the match."
          },
          "seed": {
            "title": "Seed",
            "type": "integer"
          },
          "turns_left": {
            "title": "Turns Left",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "seed",
          "locale",
          "turns_left",
          "cast",
          "known",
          "plan",
          "notebook"
        ],
        "title": "MatchState",
        "type": "object"
      },
      "NewAccusation": {
        "description": "One per match, irreversible (RN-031). Choose carefully.",
        "properties": {
          "culprit": {
            "description": "Character id you are naming.",
            "title": "Culprit",
            "type": "string"
          },
          "evidence": {
            "default": [],
            "description": "Fact ids you offer in support. Only ones you hold count.",
            "items": {
              "type": "string"
            },
            "title": "Evidence",
            "type": "array"
          },
          "motive_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why they did it. Optional — unclaimed is not wrong.",
            "title": "Motive Key"
          }
        },
        "required": [
          "culprit"
        ],
        "title": "NewAccusation",
        "type": "object"
      },
      "NewMatch": {
        "properties": {
          "locale": {
            "default": "pt-BR",
            "description": "Fixed for the match (ADR-0005).",
            "title": "Locale",
            "type": "string"
          },
          "seed": {
            "description": "Same seed, same mystery.",
            "title": "Seed",
            "type": "integer"
          },
          "suspects": {
            "default": 6,
            "maximum": 8.0,
            "minimum": 3.0,
            "title": "Suspects",
            "type": "integer"
          }
        },
        "required": [
          "seed"
        ],
        "title": "NewMatch",
        "type": "object"
      },
      "Outcome": {
        "description": "The verdict, and the only moment the solution may cross the wire.\n\nRN-011 governs a match in progress. This is its ending: the player has\nspent their one accusation and is owed the answer, right or wrong.",
        "properties": {
          "accused": {
            "title": "Accused",
            "type": "string"
          },
          "correct": {
            "title": "Correct",
            "type": "boolean"
          },
          "culprit": {
            "title": "Culprit",
            "type": "string"
          },
          "culprit_points": {
            "title": "Culprit Points",
            "type": "integer"
          },
          "epilogue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "How it ended, in prose. Absent when no model could write it — the verdict above does not depend on it (RN-032).",
            "title": "Epilogue"
          },
          "evidence_expected": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Expected",
            "type": "array"
          },
          "evidence_hit": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Hit",
            "type": "array"
          },
          "evidence_points": {
            "title": "Evidence Points",
            "type": "integer"
          },
          "means": {
            "title": "Means",
            "type": "string"
          },
          "motive": {
            "title": "Motive",
            "type": "string"
          },
          "motive_correct": {
            "title": "Motive Correct",
            "type": "boolean"
          },
          "motive_points": {
            "title": "Motive Points",
            "type": "integer"
          },
          "score": {
            "title": "Score",
            "type": "integer"
          },
          "speed_points": {
            "title": "Speed Points",
            "type": "integer"
          },
          "turns_left": {
            "title": "Turns Left",
            "type": "integer"
          }
        },
        "required": [
          "correct",
          "motive_correct",
          "accused",
          "culprit",
          "means",
          "motive",
          "score",
          "culprit_points",
          "motive_points",
          "evidence_points",
          "speed_points",
          "evidence_expected",
          "evidence_hit",
          "turns_left"
        ],
        "title": "Outcome",
        "type": "object"
      },
      "Question": {
        "properties": {
          "question": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "suspect": {
            "description": "Character id, e.g. sus-1.",
            "title": "Suspect",
            "type": "string"
          }
        },
        "required": [
          "suspect",
          "question"
        ],
        "title": "Question",
        "type": "object"
      },
      "Review": {
        "description": "A finished match, in order, with the budget reconciled.\n\n`budget`, `turns_left` and the costs in `record` add up, by construction:\nevery turn that was charged is a row here, including the ones that produced\nnothing.",
        "properties": {
          "budget": {
            "title": "Budget",
            "type": "integer"
          },
          "evidence_trail": {
            "items": {
              "$ref": "#/components/schemas/HeldEvidence"
            },
            "title": "Evidence Trail",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome",
            "description": "Recomputed from the record, not read from a stored copy (RN-036). The epilogue is not part of it: prose was never persisted, and its absence changes nothing about the score."
          },
          "record": {
            "items": {
              "$ref": "#/components/schemas/ReviewedTurn"
            },
            "title": "Record",
            "type": "array"
          },
          "seed": {
            "title": "Seed",
            "type": "integer"
          },
          "stance_trail": {
            "items": {
              "$ref": "#/components/schemas/StanceMove"
            },
            "title": "Stance Trail",
            "type": "array"
          },
          "turns_left": {
            "title": "Turns Left",
            "type": "integer"
          },
          "turns_spent": {
            "title": "Turns Spent",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "seed",
          "locale",
          "budget",
          "turns_left",
          "turns_spent",
          "record",
          "stance_trail",
          "evidence_trail",
          "outcome"
        ],
        "title": "Review",
        "type": "object"
      },
      "ReviewedTurn": {
        "description": "One turn as the review shows it: what was asked, and what became of it.\n\nThis carries the bookkeeping `Said` withholds — `lied`, `fact_referenced`,\n`clue_revealed`. It is safe here and nowhere else, for the same reason\n`Outcome` may carry the solution: the match is over. A review of a match\nstill being played would be a lie detector, so there is no such thing\n(RN-035).",
        "properties": {
          "answered": {
            "title": "Answered",
            "type": "boolean"
          },
          "character": {
            "title": "Character",
            "type": "string"
          },
          "character_name": {
            "title": "Character Name",
            "type": "string"
          },
          "claimed_interval": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "When they said it about. An hour index from the plan.",
            "title": "Claimed Interval"
          },
          "claimed_room": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where they said they were. A room id from the plan.",
            "title": "Claimed Room"
          },
          "clue_revealed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The fact this answer gave away, if it gave one away.",
            "title": "Clue Revealed"
          },
          "cost": {
            "description": "Turns this one cost. A confrontation costs two (RN-030).",
            "title": "Cost",
            "type": "integer"
          },
          "fact_referenced": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fact Referenced"
          },
          "intent": {
            "description": "How it was classified before anybody answered (RN-040).",
            "title": "Intent",
            "type": "string"
          },
          "lied": {
            "default": false,
            "title": "Lied",
            "type": "boolean"
          },
          "line": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "What they said. Absent when nothing was.",
            "title": "Line"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "rejected_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Which check discarded the reply: `canary`, `scope`, `contradiction`, `refusal`. A name, never the offending text.",
            "title": "Rejected By"
          },
          "stance": {
            "$ref": "#/components/schemas/Stance",
            "description": "The stance the turn left them in."
          },
          "turn": {
            "title": "Turn",
            "type": "integer"
          }
        },
        "required": [
          "turn",
          "cost",
          "character",
          "character_name",
          "question",
          "intent",
          "answered",
          "stance"
        ],
        "title": "ReviewedTurn",
        "type": "object"
      },
      "Room": {
        "properties": {
          "id": {
            "description": "Stable id, e.g. `study`. What a claim names.",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "How to write it in this match's language.",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "Room",
        "type": "object"
      },
      "Said": {
        "description": "One turn in the notebook, whether or not anybody said anything.\n\nA turn that produced nothing was still charged (RN-030), so it is in the\nnotebook the same as the rest. Leaving it out would make the budget\nunexplainable to the player, and would force a front end to keep its own\ncopy of what happened — which is a second source for the same truth.\n\nWhat it does *not* say is which check discarded the reply. The name of the\ncheck is information the player did not earn: `contradiction` would tell\nthem a suspect contradicted themselves. Same reason `Answer.reason` stays\ncoarse.",
        "properties": {
          "answered": {
            "title": "Answered",
            "type": "boolean"
          },
          "character": {
            "title": "Character",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "What they said. Absent when nothing was.",
            "title": "Line"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "stance": {
            "$ref": "#/components/schemas/Stance"
          },
          "turn": {
            "title": "Turn",
            "type": "integer"
          }
        },
        "required": [
          "turn",
          "character",
          "question",
          "answered",
          "stance"
        ],
        "title": "Said",
        "type": "object"
      },
      "Stance": {
        "description": "How a suspect is holding up. Transitions are code, never the model's call.\n\nThe model may suggest one; the backend validates it against the machine in\n`firenze.interrogation.stance` and keeps the current stance if the\nsuggestion is not a legal move (RN-023). `broken` is absorbing and is only\nreachable by confrontation, which arrives in phase 4.",
        "enum": [
          "cooperative",
          "evasive",
          "hostile",
          "broken"
        ],
        "title": "Stance",
        "type": "string"
      },
      "StanceMove": {
        "description": "A suspect changing footing, and the turn that did it.",
        "properties": {
          "became": {
            "$ref": "#/components/schemas/Stance"
          },
          "character": {
            "title": "Character",
            "type": "string"
          },
          "character_name": {
            "title": "Character Name",
            "type": "string"
          },
          "turn": {
            "title": "Turn",
            "type": "integer"
          },
          "was": {
            "$ref": "#/components/schemas/Stance"
          }
        },
        "required": [
          "turn",
          "character",
          "character_name",
          "was",
          "became"
        ],
        "title": "StanceMove",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
